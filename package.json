{
  "name": "ruz-mcp",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:http": "tsx src/server-http.ts",
    "build": "tsc --project tsconfig.build.json",
    "start:prod": "node dist/server-http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/financials.test.ts tests/ruz-client.test.ts tests/oauth-config.test.ts",
    "test:live": "vitest run tests/ruz-client.live.test.ts --reporter=verbose",
    "test:mcp-live": "vitest run tests/mcp.live.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "description": "MCP server nad Registrom účtovných závierok SR (RÚZ) — finančné profily firiem podľa IČO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originalmagneto/RUZ-MCP.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "slovakia",
    "ruz",
    "financial-statements",
    "kyc",
    "aml",
    "due-diligence"
  ]
}
